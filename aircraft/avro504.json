{
  "id": "avro504",
  "panel": "analog",
  "panelStyle": "wood",
  "analogPanel": {
    "_note": "G-EBHB (Avro 504K E2977) from a photo of its genuine instruments (key.aero, '504 Reborn') — sources/avro-504k-panel-notes.md",
    "groups": [
      { "name": "board", "rows": [
        [{ "id": "airP", "size": "XS", "scale": { "max": 5, "step": 1, "start": 310, "sweep": 100 }, "unconfirmed": "the figures are not readable; a 504K pilot kept 2.5–4 psi — 0–5 lb/sq in is a guess" }, { "id": "compass", "size": "L", "variant": "bubble" }],
        [{ "id": "level", "size": "L" }],
        [{ "id": "asi", "size": "L", "scale": { "unit": "mph", "zero": true, "min": 40, "max": 160, "step": 10, "minor": 2, "start": 0, "sweep": 320 } }, { "id": "clock", "size": "XS" }, { "id": "alt", "size": "S" }, { "id": "pulsator", "size": "XS" }, { "id": "rpm", "size": "L", "scale": { "max": 1600, "step": 200, "redLine": 1200 } }]
      ] }
    ],
    "absent": ["attitude indicator (horizon)", "turn & slip", "rate of climb"]
  },
  "name": "Avro 504K",
  "manufacturer": "avro",
  "family": "avro-504",
  "model": "avro-504k",
  "clock": "analog",
  "callsign": "Wolfskopf",
  "icaoType": "AV04",
  "landSurfaces": ["runway", "grass"],
  "gearRuggedness": 0.7,
  "era": "WWI / 1918",
  "engine": { "type": "piston", "count": 1, "model": "le-rhone-9j", "idleRpm": 400, "maxRpm": 1200, "description": "Le Rhône 9J rotary, 110hp" },

  "envelope": {
    "cruiseAlt":  5000,
    "maxAlt":    16000,
    "cruiseSpd":  72,
    "maxSpd":     83,
    "spdProfile": {
      "16000": 72,
      "3000":  72,
      "500":   65,
      "0":     50
    }
  },

  "situations": [
    { "label": "GROUND",   "alt": 100,  "spd": 0,  "hdg": 45, "altT": 100,  "spdT": 0  },
    { "label": "TAKEOFF",  "alt": 100,  "spd": 50, "hdg": 45, "altT": 3000, "spdT": 83 },
    { "label": "CLIMB",    "alt": 1500, "spd": 72, "hdg": 45, "altT": 5000, "spdT": 72 },
    { "label": "CRUISE",   "alt": 5000, "spd": 72, "hdg": 45, "altT": 5000, "spdT": 72 },
    { "label": "APPROACH", "alt": 500,  "spd": 55, "hdg": 45, "altT": 100,  "spdT": 50 }
  ],

  "thrustProfiles": [
    { "label": "OFF",  "spdT": 0  },
    { "label": "BLIP", "spdT": 50 },
    { "label": "FULL", "spdT": 83 }
  ],

  "manualControl": true,
  "fixedGear": true,

  "performance": {
    "mass":       830,
    "wingArea":   32.5,
    "thrustMax":  2200,
    "CL_0":       0.25,
    "CL_alpha":   4.8,
    "CL_max":     1.5,
    "CD_0":       0.048,
    "inducedK":   0.065,
    "Vr":         40,
    "muRoll":     0.07,
    "muBrake":    0.30
  },

  "handling": {
    "rollRate":  20,
    "pitchRate":  4,
    "maxBank":   45,
    "maxPitch":  25
  },

  "flaps": [
    { "deg": 0, "dCL_max": 0.0, "dCD_0": 0.000 }
  ],

  "rotaryEngine": {
    "note": "Blip switch only — no conventional throttle. Full power or ignition cut.",
    "gyroscopicTorque": true,
    "leftTurnFaster": true,
    "castoroilRange": "limited"
  },

  "sound": {
    "engineType": "rotary-9"
  },



  "pmCallouts": [
    { "alt": 3000, "speech": "passing three thousand" },
    { "alt": 2000, "speech": "passing two thousand"   },
    { "alt": 1000, "speech": "passing one thousand"   },
    { "alt": 500,  "speech": "five hundred"           }
  ],

  "crewCallouts": {
    "instructor": "Watch your rudder — she pulls left on climb.",
    "atc": "Avro 504, clear to land, wind calm."
  },

  "externalSensor": {
    "note": "Future HIL integration — Severin Bengs 4-Zylinder via WebSerial",
    "type": "webserial",
    "mapping": {
      "rpm":  "state.engineRPM",
      "temp": "state.engineTemp"
    }
  }
}
