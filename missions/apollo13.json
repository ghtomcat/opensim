    {
      "t": 201293,
      "voice": "crew",
      "text": "Houston, we've had a problem. We've had a main B bus undervolt."
    },
    {
      "t": 201360,
      "voice": "capcom",
      "text": "Roger. Main B undervolt. Okay, stand by Thirteen, we're looking at it."
    },
    {
      "t": 201480,
      "voice": "crew",
      "text": "Houston, we are venting something out into space. It's a gas of some sort."
    },
    {
      "t": 201600,
      "voice": "capcom",
      "text": "Roger, we copy you venting."
    },
    {
      "t": 210000,
      "voice": "capcom",
      "text": "Thirteen, we want you to start powering down as much as you can."
    },
    {
      "t": 211000,
      "voice": "crew",
      "text": "We're starting to power down, Houston. Moving to the LM."
    },

    {
      "t": 277200,
      "voice": "capcom",
      "text": "Aquarius, you're go for the Moon. Pericynthion in twenty minutes."
    },
    {
      "t": 277320,
      "voice": "crew",
      "text": "Roger. There it is. Right there. God, look at that."
    },
    {
      "t": 277500,
      "voice": "capcom",
      "text": "Thirteen, you're go for PC+2."
    },

    {
      "t": 287759,
      "voice": "capcom",
      "text": "Aquarius, sixty seconds to ignition."
    },
    {
      "t": 287859,
      "voice": "crew",
      "text": "Ignition."
    },
    {
      "t": 288122,
      "voice": "crew",
      "text": "Shutdown. That was a good burn."
    },
    {
      "t": 288180,
      "voice": "capcom",
